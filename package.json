{
  "name": "dsh-wx-desktop",
  "version": "0.3.1",
  "description": "微信桌面桥 / WeChat Desk Bridge：在 Windows 上用真实的电脑微信客户端驱动 DSH agent——监听本地消息库、唤醒会话、把回复打回聊天窗口（自带设置面板）。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "wechat",
    "weixin",
    "desktop",
    "automation",
    "agent"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "files": [
    "index.js",
    "client.js",
    "panel.js",
    "cordis.patch.yml",
    "setup.ps1",
    "install.ps1",
    "bootstrap.ps1",
    "scripts/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHSCN123/dsh-wechat-desktop.git"
  },
  "homepage": "https://github.com/CHSCN123/dsh-wechat-desktop#readme",
  "bugs": {
    "url": "https://github.com/CHSCN123/dsh-wechat-desktop/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
